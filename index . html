<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Noor Collection - Rs 800</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:sans-serif}
body{background:#fff8fa}
header{background:linear-gradient(135deg,#ff0a54,#ff5a5f);color:#fff;padding:18px;text-align:center;position:sticky;top:0;z-index:10}
.banner{background:#ffe5e9;color:#d90429;text-align:center;padding:10px;font-weight:800}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;padding:12px;max-width:1200px;margin:auto}
.card{background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 4px 12px rgba(0,0,0,.1)}
.card img{width:100%;aspect-ratio:3/4;object-fit:cover}
.b{padding:10px}.price{color:#d90429;font-weight:900}.old{color:#999;font-size:12px;text-decoration:line-through}
.t{font-size:12px;margin:5px 0}
.btn{display:block;background:#25D366;color:#fff;text-align:center;padding:9px;border-radius:8px;text-decoration:none;font-weight:700;margin-top:6px}
</style>
</head>
<body>
<header><h1>NOOR COLLECTION</h1><p>Sanganer, Jaipur - All Dress Rs 800</p></header>
<div class="banner">🔥 All 35 Dress - Fixed Price Rs 800 - Free Shipping 🔥</div>
<div class="grid" id="g">Loading 35 Dress...</div>
<script>
const repo="noorcollectiongujrat/Navratri-website";
fetch(`https://api.github.com/repos/${repo}/contents`).then(r=>r.json()).then(files=>{
 let imgs=files.filter(f=>f.name.match(/\.jpe?g$/i));
 let g=document.getElementById('g'); g.innerHTML='';
 imgs.slice(0,35).forEach((f,i)=>{
  let url=`https://raw.githubusercontent.com/${repo}/main/${f.name}`;
  g.innerHTML+=`<div class="card"><img src="${url}" loading="lazy"><div class="b"><div><span class="price">Rs 800</span><span class="old">Rs 1999</span></div><div class="t">Design ${i+1} - Noor Collection</div><a class="btn" href="https://wa.me/917976190995?text=Hello Noor Collection! Design ${i+1} Rs 800 chahiye - ${url}" target="_blank">🛒 WhatsApp Order</a></div></div>`;
 });
});
</script>
</body>
</html>
